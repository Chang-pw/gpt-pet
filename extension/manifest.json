{
  "manifest_version": 3,
  "name": "ChatGPT Button Pet",
  "version": "0.1.0",
  "description": "Attach a small pet above the ChatGPT send button.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/cat-pet.webm",
        "assets/laifu.webm"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
