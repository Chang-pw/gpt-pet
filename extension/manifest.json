{
  "manifest_version": 3,
  "name": "ChatGPT Button Pet",
  "version": "0.1.0",
  "description": "Attach a small pet above the ChatGPT send button.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GPT Pet",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/laifu.webm",
        "assets/chris.webm",
        "assets/xiaoxiao.webm"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
